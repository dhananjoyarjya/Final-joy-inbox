# Firebase Admin SDK
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"

# Alternative: use complete service account JSON instead.
# If used, the three FIREBASE_* values above are not required.
# FIREBASE_SERVICE_ACCOUNT=YOUR_SERVICE_ACCOUNT_JSON

# Owner Firebase Authentication UID
OWNER_UID=YOUR_OWNER_UID

# WhatsApp Cloud API
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN

# Meta webhook security
META_APP_SECRET=YOUR_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# Exact frontend origin(s), comma-separated
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
